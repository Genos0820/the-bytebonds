# Copy to .env.local and fill in. .env.local is gitignored.

# ─── Contact form (Formspree) ────────────────────────────────────────────────
# 1. Create a free account at https://formspree.io
# 2. Create a new form and set its notification email to your shared inbox
# 3. Copy the form ID from the endpoint it gives you —
#    https://formspree.io/f/ABCD1234  →  the ID is ABCD1234
#
# This value is NOT a secret. Formspree form IDs are embedded in the page by
# design, which is why this is a NEXT_PUBLIC_ variable. Spam protection comes
# from Formspree's own filtering plus the honeypot field in the form.
#
# Leave it unset and the contact page shows the email address instead of a form,
# so nothing is broken before you set this up.
NEXT_PUBLIC_FORMSPREE_ID=

# ─── Site URL ────────────────────────────────────────────────────────────────
# Used for canonical URLs and Open Graph tags. No trailing slash.
# Falls back to the `url` field in src/content/site.ts when unset.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
